# Copy this file to .env and fill in the values. Never commit .env.

# --- Django ---
# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- AI assistant (optional) ---
# Free key: https://aistudio.google.com/app/apikey
# Without it, everything except the chatbot still works.
GEMINI_API_KEY=

# --- Email (optional) ---
# Leave these empty in development: with DEBUG=True, emails are printed to the console.
# For real emails, use a Gmail address and an App Password:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Defaults shown; uncomment only to change them.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=       # defaults to EMAIL_HOST_USER
# EMAIL_BACKEND=            # set only to force a specific backend
